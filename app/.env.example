# URL base del backend (server/). Expo inyecta cualquier variable EXPO_PUBLIC_* en el bundle.
#
# - Simulador/emulador (mismo equipo que corre `npm run dev` en server/): usar localhost.
# - Celular físico con Expo Go: NO se puede usar localhost (es el localhost del celular).
#   Usar la IP local de tu computadora en la misma red Wi-Fi, ej: http://192.168.1.10:3000/api
#   (podés obtenerla con `ipconfig` en Windows o `ifconfig`/`ip addr` en Mac/Linux).
EXPO_PUBLIC_API_URL=http://localhost:3000/api
