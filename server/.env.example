# Opcional para desarrollo: si se omite MONGODB_URI, el servidor levanta automáticamente
# una MongoDB en memoria (mongodb-memory-server) solo para ese proceso — no hay que instalar
# ni correr Mongo localmente para probar el backend. Para producción, definí una conexión real:
# MONGODB_URI=mongodb+srv://usuario:password@cluster.mongodb.net/guatapay

# Opcional para desarrollo: si se omite, se usa un secreto por defecto (con warning en consola).
# En producción es obligatorio definir uno propio.
# JWT_SECRET=change-me

PORT=3000
NODE_ENV=development
